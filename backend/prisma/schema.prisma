generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Comment {
  id                 Int      @id @default(autoincrement())
  platform           String
  userNickname       String
  content            String
  commentTimeDisplay String?
  replyContent       String?
  status             String   @default("pending")
  uniqueHash         String   @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([status])
  @@index([platform])
  @@index([createdAt])
}
