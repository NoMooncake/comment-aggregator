# 跟 .gitignore 思路一致，但 Docker 还要排除更多构建无关文件

# 依赖（容器内 pnpm install 重装）
**/node_modules
**/.pnpm-store

# 构建产物（多阶段构建会生成）
**/dist
**/build
**/*.tsbuildinfo

# 环境变量（绝不进镜像，运行时由 compose 注入）
**/.env
**/.env.local
**/.env.*.local

# 数据库（运行时由 volume 提供）
**/*.db
**/*.db-journal

# Git / IDE / OS
.git
.gitignore
.github
.vscode
.idea
**/.DS_Store

# 日志
**/*.log

# 文档（不需要进镜像）
*.md
DEMO.md
DEPLOYMENT.md
HARDENING.md
试用指南.md
README.md

# 本仓库的迁移历史（migrate deploy 时由 prisma 目录提供）
backend/prisma/dev.db
backend/prisma/migrations/dev

# 测试 / 开发临时
backend/uploads
